NODE_ENV=production
PORT=3000
# Mesma zona em todas as réplicas para datas operacionais de rotas.
TZ=America/Sao_Paulo

# debug so em dev: em producao enche o Loki de ruido e custa disco.
LOG_LEVEL=info

POSTGRES_USER=motiva
POSTGRES_PASSWORD=troca-isso-por-uma-senha-forte
POSTGRES_DB=motiva
DATABASE_URL=postgresql://motiva:troca-isso-por-uma-senha-forte@postgres:5432/motiva

JWT_SECRET=troca-isso-por-um-segredo-forte-de-32-caracteres

FRONTEND_URL=https://seu-dominio.com

MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Produção: identidade estável e exclusiva por réplica (ex.: ordinal do StatefulSet).
MQTT_CLIENT_ID=motiva-mqtt-0
MQTT_SHARED_GROUP=motiva

REDIS_URL=redis://redis:6379
# Mesmo prefixo nos processos do ambiente; distinto entre ambientes.
QUEUE_PREFIX=bull

VEHICLE_CAPTURES_DIR=/data/vehicle-captures
CLASSIFIER_URL=http://classifier:8000

WORK_ORDER_PHOTOS_DIR=/data/work-order-photos
WORK_ORDER_PHOTO_DISTANCE_TOLERANCE_M=150
WORK_ORDER_PHOTO_TIME_TOLERANCE_S=86400

# Runtime: api, domain, images, mqtt; all is convenient for local development.
BACKEND_ROLE=all
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_SECONDS=10
SEGMENT_MATCH_RADIUS_M=500
CLASSIFIER_TIMEOUT_MS=30000
# Production APIs and image workers require shared storage.
STORAGE_DRIVER=s3
S3_BUCKET=motiva-photos
S3_REGION=us-east-1
# S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=false
# Supply AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY via your secret manager.

# CLI de limpeza de uploads pendentes; mínimo 24 h. Não apaga histórico associado.
UPLOAD_CLEANUP_GRACE_HOURS=24
