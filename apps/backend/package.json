{
  "name": "backend",
  "version": "1.0.0",
  "description": "Motiva backend API",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "test": "jest",
    "migrate": "node dist/src/migrate.js",
    "seed": "node dist/src/seed.js",
    "generate": "npm exec -- drizzle-kit generate",
    "test:integration": "npm run build && node scripts/test-integration.cjs",
    "storage:migrate": "node dist/src/platform/operations/migrate-photos.js",
    "outbox:replay": "node dist/src/platform/operations/replay-outbox.js",
    "start:api": "BACKEND_ROLE=api node dist/src/main.js",
    "start:domain": "BACKEND_ROLE=domain node dist/src/main.js",
    "start:images": "BACKEND_ROLE=images node dist/src/main.js",
    "start:mqtt": "BACKEND_ROLE=mqtt node dist/src/main.js",
    "storage:cleanup": "node dist/src/platform/operations/cleanup-uploads.js",
    "benchmark": "npm run build && node scripts/benchmark.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.76.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "ioredis": "^5.10.1",
    "mqtt": "^5.15.1",
    "nestjs-pino": "^4.6.1",
    "pdfkit": "^0.20.2",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@nestjs/cli": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.0",
    "@types/pdfkit": "^0.17.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.16.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0"
  }
}
